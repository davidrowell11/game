{
  "name": "depthwarden",
  "version": "1.0.0",
  "description": "A 3D roguelite dungeon crawler with procedurally generated dungeons.",
  "author": "David Rowell",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/davidrowell11/game",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "three": "0.170.0",
    "vite": "6.0.7"
  },
  "build": {
    "appId": "com.davidrowell.depthwarden",
    "productName": "Depthwarden",
    "copyright": "Copyright © 2026 David Rowell",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Depthwarden"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null
    },
    "dmg": {
      "title": "Depthwarden"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "afterPack": "build/afterPack.cjs"
  }
}
