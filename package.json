{
  "name": "depthwarden",
  "version": "1.2.1",
  "description": "A 3D roguelite dungeon crawler with procedurally generated dungeons.",
  "author": "David Rowell",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/davidrowell11/game",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "three": "0.170.0",
    "vite": "6.0.7"
  },
  "build": {
    "appId": "com.davidrowell.depthwarden",
    "productName": "Depthwarden",
    "copyright": "Copyright © 2026 David Rowell",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Depthwarden-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Depthwarden",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "Depthwarden-mac.${ext}"
    },
    "dmg": {
      "title": "Depthwarden",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "Depthwarden-linux.${ext}"
    },
    "afterPack": "build/afterPack.cjs"
  }
}
